{
  "name": "@deepseek-ai/dsh-writehere",
  "description": "WriteHereAgent driver and host-plane bind of article-editor to writehere",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/writehere"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./src/invariant.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-drivers": "*",
    "@deepseek-ai/dsh-article-tree": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-drivers": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-agent-loop-testkit": "*",
    "@deepseek-ai/dsh-article-tree": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
